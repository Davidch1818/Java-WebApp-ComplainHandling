<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.comphand.model">
    <!-- table is "app_user" because "user" is a reserved word in PostgreSQL -->
    <class name="User" table="app_user">
        <id name="id" column="id">
            <generator class="identity" />
        </id>
        <property name="username" column="username" not-null="true" unique="true" length="100" />
        <property name="email" column="email" not-null="true" length="255" />
    </class>
</hibernate-mapping>
