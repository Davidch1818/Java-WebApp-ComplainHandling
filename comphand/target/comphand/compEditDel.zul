<?page title="Complain Handling Add" contentType="text/html;charset=UTF-8"?>
<zk>
    <window id="inputComp" title="Complain Input" apply="org.zkoss.bind.BindComposer" viewModel="@id('vm') @init('com.comphand.viewmodel.CompHandVM')" 
            validationMessages="@id('vmsgs')" border="normal" width="100%" height="100%" contentStyle="overflow-y:auto;" onCreate="@command('showFormEdel')" >
        
        <div sclass="divContainer">
            <include src="compList.zul"/>

            <groupbox mold="3d" width="100%">
                <include src="compDetailForm.zul"/>
            </groupbox>
        </div>
    </window>
</zk>
