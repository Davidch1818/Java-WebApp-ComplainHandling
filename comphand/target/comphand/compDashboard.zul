<?page title="Complain Handling Add" contentType="text/html;charset=UTF-8"?>
<zk>
    <window id="inputComp" title="Complain Input" apply="org.zkoss.bind.BindComposer" viewModel="@id('vm') @init('com.comphand.viewmodel.CompHandVM')" 
            validationMessages="@id('vmsgs')" border="normal" width="100%" height="100%" contentStyle="overflow-y:auto;" onCreate="@command('showFormDash')" >
        
        <div sclass="divContainer">
            <vbox>
                <label value="Dashboard" style="font-size: 20px; font-weight: bold;" />
                <label value="Welcome to the Ops Helpdesk Complaint Management System. Manage complaints efficiently within the 5-day SLA." />
            </vbox>
            <!-- Escalation Alert -->
            <hlayout style="background-color: #ffe4b5; border-left: 5px solid #f39200; margin-top: 10px; padding: 8px; margin-right: 10px;">
                <label value="Escalation Alert:" style="font-weight: bold;"/>
                <label value="Complaints unresolved for more than 3 days are automatically escalated to a manager." />
            </hlayout>
            <separator/>
            <include src="compList.zul"/>
        </div>
    </window>
</zk>
